{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "version.json",
  "title": "Version",
  "type": "object",
  "required": ["version_id", "document_id", "checksum", "version_status", "created_at"],
  "properties": {
    "version_id": { "type": "string" },
    "document_id": { "type": "string" },
    "checksum": { "type": "string" },
    "version_status": { "type": "string", "enum": ["active", "superseded", "draft", "deprecated"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

