{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query_response.json",
  "title": "QueryResponse",
  "type": "object",
  "required": [
    "answer",
    "citations",
    "confidence",
    "applied_filters",
    "rewrites_applied",
    "decision_trace",
    "fallback_reason",
    "source_conflict"
  ],
  "properties": {
    "answer": { "type": "string" },
    "citations": { "type": "array", "items": { "$ref": "citation.json" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "applied_filters": { "type": "object" },
    "rewrites_applied": { "type": "array", "items": { "type": "string" } },
    "decision_trace": { "type": "array", "items": { "type": "string" } },
    "fallback_reason": { "type": ["string", "null"] },
    "source_conflict": { "type": "boolean" }
  }
}

